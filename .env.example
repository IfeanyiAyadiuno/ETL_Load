# Copy this file to `.env` in the application directory (same folder as the
# executable when deployed, or the project folder when running from source).
# Do not share `.env` — it contains secrets.

# --- SQL Server (optional overrides; Windows auth) ---
# If unset, defaults are defined in db_connection.py
# SQL_SERVER=your-sql-host
# SQL_DATABASE=your_database_name
# SQL_DRIVER={ODBC Driver 17 for SQL Server}

# --- Snowflake (required for Prodview / Snowflake pulls) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=
# SNOWFLAKE_ROLE=
