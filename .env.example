# Copy to .env and fill in values. Do not commit .env to source control.

# SQL Server (optional — server/database can also be set in settings.ini [SQL])
SQL_SERVER=YOUR_SQL_SERVER
SQL_DATABASE=YOUR_DATABASE
SQL_DRIVER={ODBC Driver 17 for SQL Server}

# Snowflake (required for Prodview and Well Master Snowflake import)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
